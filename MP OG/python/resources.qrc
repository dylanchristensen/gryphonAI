<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="icons">
        <file alias="mp_logo">resources/icons/MP-logo-small-blue.png</file>
        <file alias="exit">resources/icons/application-exit.png</file>
        <file alias="documentation">resources/icons/help-contents-5.png</file>
        <file alias="about_mp">resources/icons/document-properties.png</file>
        <file alias="run">resources/icons/run-build-install.png</file>
        <file alias="cancel">resources/icons/dialog-cancel-3.png</file>
        <file alias="clear_log">resources/icons/edit-clear-list.png</file>
        <file alias="open">resources/icons/document-open-2.png</file>
        <file alias="close">resources/icons/document-close.png</file>
        <file alias="save">resources/icons/document-save-2.png</file>
        <file alias="import_gry">resources/icons/document-import-2.png</file>
        <file alias="export_gry">resources/icons/document-export-4.png</file>
        <file alias="trace_event_menu">resources/icons/Events_icon.png</file>
        <file alias="sort_ascending">resources/icons/go-down-3.png</file>
        <file alias="sort_descending">resources/icons/go-up-3.png</file>
        <file alias="filter">resources/icons/view-filter.png</file>
        <file alias="find_and_replace">resources/icons/edit-find-and-replace-2.png</file>
        <file alias="search_mp_files">resources/icons/edit-find-5.png</file>
        <file alias="left_arrow">resources/icons/arrow-left-2.png</file>
        <file alias="right_arrow">resources/icons/arrow-right-2.png</file>
        <file alias="zoom_in">resources/icons/zoom-in-3.png</file>
        <file alias="zoom_out">resources/icons/zoom-out-3.png</file>
        <file alias="zoom_reset">resources/icons/zoom-original-2.png</file>
        <file alias="show_model_statistics">resources/icons/document-new-7.png</file>
        <file alias="copy_csv">resources/icons/edit-copy.png</file>
        <file alias="dark_mode">resources/icons/computer-7.png</file>
        <file alias="light_mode">resources/icons/computer-laptop-2.png</file>
        <file alias="move_undo">resources/icons/edit-undo-7.png</file>
        <file alias="move_redo">resources/icons/edit-redo-7.png</file>
    </qresource>
    <qresource prefix="images">
        <file alias="phoenix_logo">resources/images/phoenix_logo_color-01nps_cropped.jpg</file>
        <file alias="nps_logo">resources/images/nps_logo_hz.jpg</file>
    </qresource>
    <qresource prefix="settings">
        <file alias="default_settings">resources/settings/default_settings.stg</file>
        <file alias="nps">resources/settings/NPS.stg</file>
        <file alias="firebird">resources/settings/Firebird.stg</file>
        <file alias="serc">resources/settings/SERC.stg</file>
        <file alias="grayscale">resources/settings/Grayscale.stg</file>
        <file alias="grayscale_dark">resources/settings/Grayscale_dark.stg</file>
        <file alias="navy">resources/settings/Navy.stg</file>
    </qresource>
    <qresource>
        <file alias="spellcheck_whitelist">resources/spellcheck_whitelist.txt</file>
    </qresource>
</RCC>
