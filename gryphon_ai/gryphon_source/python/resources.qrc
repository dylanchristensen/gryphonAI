        <file alias="help">icons/help-contents-5.png</file>
        <file alias="about_mp">icons/document-properties.png</file>
        <file alias="run">icons/run-build-install.png</file>
        <file alias="cancel">icons/dialog-cancel-3.png</file>
        <file alias="clear_log">icons/edit-clear-list.png</file>
        <file alias="open">icons/document-open-2.png</file>
        <file alias="close">icons/document-close.png</file>
        <file alias="save">icons/document-save-2.png</file>
        <file alias="import_gry">icons/document-import-2.png</file>
        <file alias="export_gry">icons/document-export-4.png</file>
        <file alias="event_menu">icons/Events_icon.png</file>
        <file alias="sort_ascending">icons/go-down-3.png</file>
        <file alias="sort_descending">icons/go-up-3.png</file>
        <file alias="filter">icons/view-filter.png</file>
